  {
    "name": "bangumi.query_subjects",
    "description": "按受控条件发现 Bangumi 条目。支持媒体类型、季/月日期、标签、概念、评分/排名/收藏人数范围与 explain；它是有界、可解释的 discovery，不替代已知 ID 的 bangumi.get_subject。",
    "auth": "none",
    "risk": "read",
    "scopes": [],
    "policyMode": "static",
    "inputSchema": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "maxLength": 200
        },
        "media": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["anime", "book", "music", "game", "real"]
            },
            {
              "minItems": 1,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["anime", "book", "music", "game", "real"]
              }
            }
          ]
        },
        "categories": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["tv", "ova", "movie", "web"]
            },
            {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
