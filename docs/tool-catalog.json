        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "add_subject"
            },
            "indexId": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "目录 ID"
            },
            "subjectId": {
              "type": "integer",
