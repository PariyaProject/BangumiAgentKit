  {
    "name": "bangumi.update_episode_progress",
    "description": "更新单个、批量或通过 \"看到第 N 集\" 模式更新章节进度。超过 20 集的大批量变更将自动要求二次确认。",
    "auth": "required",
    "risk": "write",
    "scopes": ["write:collection"],
    "inputSchema": {
      "type": "object",
      "properties": {
        "subjectId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Bangumi 条目 ID"
        },
        "target": {
          "description": "语义化更新目标 (推荐)",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "ids"
                },
                "episodeIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
