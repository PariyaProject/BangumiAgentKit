    "policyMode": "dynamic",
    "policyDescription": "Tool policies (auth, risk, confirmation) are resolved dynamically based on input parameters.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "subjectId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Bangumi 条目 ID"
        },
        "target": {
          "description": "语义化更新目标 (推荐)",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "ids"
                },
                "episodeIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "description": "具体章节 ID 列表"
                }
              },
              "required": ["kind", "episodeIds"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "through"
                },
                "episodeNumber": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "更新至第 N 集 (如 12 表示从第 1 集看到第 12 集)"
                },
                "category": {
                  "description": "章节分类，默认 main (正篇)",
                  "type": "string",
                  "enum": ["main", "sp", "op", "ed"]
                }
              },
              "required": ["kind", "episodeNumber"],
              "additionalProperties": false
            }
          ]
        },
        "episodeIds": {
          "description": "(Deprecated) 兼容旧参数: 章节 ID 列表",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "status": {
          "description": "更新动作: watched(看过,默认), wish(想看), dropped(抛弃)",
          "type": "string",
          "enum": ["wish", "watched", "dropped"]
        },
        "type": {
          "description": "(Deprecated) 兼容旧 API 数字: 2=看过, 1=想看, 3=抛弃",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": ["subjectId"],
      "additionalProperties": false
    }
