  {
    "name": "bangumi.manage_index",
    "description": "创建、编辑目录，向目录添加/删除条目，或收藏/取消收藏目录。从目录删除条目与取消收藏目录属于破坏性操作，需要二次确认。",
    "auth": "required",
    "risk": "write",
    "scopes": ["write:indices"],
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "edit", "add_subject", "remove_subject", "collect", "uncollect"]
        },
        "indexId": {
          "description": "目录 ID (编辑/添加/删除/收藏/取消收藏时必填)",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "subjectId": {
          "description": "条目 ID (添加/删除条目时必填)",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "title": {
          "description": "目录标题",
          "type": "string"
        },
        "desc": {
          "description": "目录描述",
          "type": "string"
        },
        "comment": {
          "description": "条目批注",
          "type": "string"
        }
      },
      "required": ["action"],
      "additionalProperties": false
    }
  },
