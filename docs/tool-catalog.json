          "minimum": 1,
          "maximum": 50
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["query", "nsfw", "limit", "offset"],
      "additionalProperties": false
    }
