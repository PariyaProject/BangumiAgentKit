          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "edit"
            },
            "indexId": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "目录 ID"
            },
            "title": {
              "description": "新标题",
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": {
              "description": "新简介",
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": ["action", "indexId"],
