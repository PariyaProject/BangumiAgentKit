{
  "name": "bangumi-agent-kit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Bangumi Agent Kit monorepo workspace",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "tsc -b --force",
    "lint": "eslint .",
    "typecheck:packages": "tsc -b",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:tests",
    "test": "vitest run tests/unit tests/render",
    "test:contract": "vitest run tests/contract",
    "test:semantic": "vitest run tests/semantic",
    "test:integration": "vitest run tests/integration",
    "test:integration:sqlite": "BANGUMI_DB_DRIVER=sqlite vitest run tests/integration",
    "test:integration:postgres": "BANGUMI_DB_DRIVER=postgres vitest run tests/integration",
    "test:render": "vitest run tests/render",
    "test:standalone": "pnpm build && vitest run tests/standalone",
    "setup:local": "ts-node -P tsconfig.base.json scripts/setup-local.ts",
    "doctor": "ts-node -P tsconfig.base.json scripts/doctor.ts",
    "doctor:host": "cd examples/nonebot2-claude-code && python3 -m bangumi_host.doctor",
    "test:host": "cd examples/nonebot2-claude-code && python3 -m unittest discover -s tests -v",
    "test:integration:host-built": "BANGUMI_REQUIRE_BUILT_HOST=1 vitest run tests/host-integration/mcp-built-host.test.ts",
    "smoke:host": "python3 scripts/smoke-host.py",
    "smoke:claude-host": "ts-node -P tsconfig.base.json scripts/smoke-claude-host.ts",
    "smoke:runtime:sqlite": "ts-node -P tsconfig.base.json scripts/smoke-runtime-sqlite.ts",
    "renderer:install": "npx playwright install chromium",
    "start:api": "pnpm --filter @bangumi-agent-kit/app-api start",
    "start:mcp": "pnpm --filter @bangumi-agent-kit/app-mcp start",
    "render:fixtures": "ts-node -P tsconfig.base.json scripts/generate-render-fixtures.ts",
    "benchmark:render": "ts-node -P tsconfig.base.json scripts/benchmark-renderer.ts",
    "db:migrate": "ts-node -P tsconfig.base.json scripts/migrate.ts",
    "openapi": "pnpm openapi:verify",
    "openapi:validate": "ts-node scripts/sync-openapi.ts --validate",
    "openapi:fetch": "ts-node scripts/sync-openapi.ts --fetch",
    "openapi:generate": "npx openapi-typescript openapi/upstream/v0.yaml --output packages/bangumi-openapi/src/generated/schema.ts && ts-node scripts/generate-openapi-client.ts && ts-node scripts/generate-operation-registry.ts && ts-node scripts/calculate-coverage.ts && pnpm build && ts-node scripts/generate-tool-catalog.ts && prettier --write \"packages/bangumi-openapi/src/generated/**/*.{ts,json}\" \"packages/bangumi-openapi/src/operation-registry.ts\" \"openapi/generated-operation-registry.json\" \"docs/api-coverage.md\" \"docs/tool-catalog.json\"",
    "openapi:registry": "ts-node scripts/generate-operation-registry.ts",
    "openapi:catalog": "ts-node scripts/generate-tool-catalog.ts",
    "openapi:verify": "pnpm openapi:validate && pnpm openapi:generate && git diff --exit-code packages/bangumi-openapi/src/generated openapi/generated-operation-registry.json packages/bangumi-openapi/src/operation-registry.ts docs/api-coverage.md docs/tool-catalog.json",
    "openapi:check": "pnpm openapi:verify",
    "format": "prettier --write \"**/*.{ts,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yaml,yml}\"",
    "standalone": "node apps/standalone/dist/main.js",
    "bak": "node apps/standalone/dist/main.js",
    "standalone:build": "pnpm --filter @bangumi-agent-kit/app-standalone build",
    "self-test": "node apps/standalone/dist/self-test-main.js",
    "smoke:standalone": "ts-node -P tsconfig.base.json scripts/smoke-standalone.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.4",
    "pg": "^8.22.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.9.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
