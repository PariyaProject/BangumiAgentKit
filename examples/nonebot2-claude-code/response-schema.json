{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 65536,
      "description": "User-facing natural language response text"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 8,
      "description": "Image artifacts returned by Bangumi MCP tools",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^art_[A-Za-z0-9_-]+$"
          },
          "mimeType": {
            "const": "image/png"
          },
          "alt": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": ["id", "mimeType"]
      }
    },
    "pendingConfirmation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "confirmationId": {
              "type": "string",
              "pattern": "^cfm_[A-Za-z0-9_-]+$"
            },
            "summary": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": ["confirmationId", "summary"]
        }
      ]
    }
  },
  "required": ["text", "artifacts", "pendingConfirmation"]
}
