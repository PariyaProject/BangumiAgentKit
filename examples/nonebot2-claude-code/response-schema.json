{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "User-facing natural language response text"
    },
    "artifacts": {
      "type": "array",
      "description": "List of rendered image artifacts generated during tool execution",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^art_[A-Za-z0-9_-]+$",
            "description": "Artifact ID returned by render tool"
          },
          "mimeType": {
            "type": "string",
            "enum": ["image/png"]
          },
          "alt": {
            "type": "string"
          }
        },
        "required": ["id", "mimeType"]
      }
    },
    "pendingConfirmation": {
      "type": ["object", "null"],
      "description": "Information about write operation requiring user confirmation",
      "properties": {
        "confirmationId": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": ["confirmationId", "summary"]
    }
  },
  "required": ["text"]
}
