{
  "mcpServers": {
    "bangumi": {
      "command": "node",
      "args": ["/absolute/path/to/BangumiAgentKit/apps/mcp/dist/main.js"],
      "env": {
        "BANGUMI_DB_DRIVER": "sqlite",
        "BANGUMI_DATA_DIR": "/absolute/path/to/bangumi-agent-kit-data",
        "BANGUMI_ENV_FILE": "/absolute/path/to/BangumiAgentKit/.env.local"
      }
    }
  }
}
